# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ---- Database ------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/sentriq
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/sentriq?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sentriq

# ---- Auth ----------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
AUTH_ENABLED=true
ADMIN_EMAIL=analyst@sentriq.io
ADMIN_PASSWORD=sentriq-demo
ADMIN_NAME=A. Ibrahim

# ---- AI (GPT) ------------------------------------------------------------
# Leave OPENAI_API_KEY empty to run the deterministic rules-only engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2

# ---- Related-incident detection -----------------------------------------
# Set to true only when an Atlas Vector Search index exists on `embedding`.
VECTOR_SEARCH_ENABLED=false
VECTOR_INDEX_NAME=incident_embedding_index
SIMILARITY_THRESHOLD=0.55
DUPLICATE_THRESHOLD=0.9
SIMILARITY_CANDIDATE_LIMIT=400
MAX_RELATED_INCIDENTS=3

# ---- Redaction policy ----------------------------------------------------
# false keeps URLs/IPs/hashes visible: they are indicators of compromise, not PII.
REDACT_TECHNICAL=false

# ---- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
